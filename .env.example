# =============================================================================
# MongoDB - paste your credentials in .env or Render environment variables
# =============================================================================
# Atlas SRV format:
# MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster0.example.mongodb.net/ayudh_vikas_db?retryWrites=true&w=majority
#
# Standard format:
# MONGODB_URI=mongodb://USER:PASSWORD@HOST:27017/ayudh_vikas_db
#
# Optional: override the database name if your URI does not include one.
MONGODB_URI=
MONGODB_DB=ayudh_vikas_db

JWT_SECRET=change-me-in-production
PORT=4000
