MONGODB_URI=
JWT_SECRET=replace-with-a-long-random-production-secret
PORT=4000
VITE_PORT=3000
# Leave empty on Vercel. The site calls /api and vercel.json proxies to Render.
VITE_API_URL=
# Comma-separated frontend origins the API may accept (required on Render for Vercel).
# Example production: CLIENT_ORIGIN=https://your-app.vercel.app,https://www.yourdomain.com
CLIENT_ORIGIN=https://ayudh-vikas-foundation.vercel.app,http://localhost:3000
ALLOWED_ORIGINS=
ALLOW_VERCEL_PREVIEWS=true
ACCESS_TOKEN_TTL_SEC=900
REFRESH_TOKEN_TTL_DAYS=30
EMAIL_USER=
EMAIL_PASSWORD=
EMAIL_FROM=noreply@ayudhvikas.com
APP_URL=http://localhost:3000
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
# Mobile OTP / SMS provider.
# Supported:
# 1) Twilio: set TWILIO_* above.
# 2) Generic HTTP SMS gateway: set SMS_PROVIDER=generic and provide URL/headers/body template.
OTP_SECRET=replace-with-a-long-random-otp-secret
OTP_TTL_SECONDS=300
OTP_PROOF_TTL_SECONDS=900
OTP_RESEND_COOLDOWN_SECONDS=30
OTP_MAX_SENDS_PER_HOUR=5
OTP_MAX_ATTEMPTS=5
OTP_DEV_EXPOSE=false
SMS_PROVIDER=
SMS_FROM=
SMS_SENDER_ID=
SMS_OTP_TEMPLATE_ID=
SMS_API_URL=
SMS_API_METHOD=POST
SMS_API_CONTENT_TYPE=application/json
SMS_API_HEADERS=
SMS_API_BODY_TEMPLATE=
