# =============================================================================
# PostgreSQL — paste your credentials here, then restart the app
# =============================================================================
# Option A (recommended): full URL
#   postgresql://USER:PASSWORD@HOST:5432/ayudh_vikas
#   postgres://USER:PASSWORD@HOST:5432/ayudh_vikas?sslmode=require
DATABASE_URL=

# Option B: separate fields (used if DATABASE_URL is empty)
# PGHOST=localhost
# PGPORT=5432
# PGUSER=ayudh
# PGPASSWORD=your_password
# PGDATABASE=ayudh_vikas

# SSL: auto-on for hosted hosts (Neon / Supabase / RDS).
# Local Postgres: leave unset. To force: DATABASE_SSL=true  or  DATABASE_SSL=false
# DATABASE_SSL=false

JWT_SECRET=change-me-in-production
PORT=4000
